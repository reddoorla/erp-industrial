{
	"name": "erp-industrial",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "vite dev --host",
		"vite:dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . --plugin prettier-plugin-svelte . && eslint .",
		"format": "prettier --write . --plugin prettier-plugin-svelte .",
		"test": "vitest run",
		"test:smoke": "playwright install chromium && playwright test",
		"prismic:gen": "prismic gen types && prismic gen slice-index"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.3",
		"@playwright/test": "^1.60.0",
		"@reddoorla/maintenance": "^0.95.1",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/kit": "^2.59.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/postcss": "^4.3.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24.0.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"jsdom": "^30.1.2",
		"postcss": "^8.5.1",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^4.0.0",
		"prismic": "^1.22.0",
		"sass": "^1.83.4",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.7",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-svelte-plugin": "^0.3.52",
		"vite": "^8.0.10",
		"vitest": "^4.1.11"
	},
	"type": "module",
	"dependencies": {
		"@lucide/svelte": "^1.20.0",
		"@prismicio/client": "^7.15.1",
		"@prismicio/svelte": "^2.2.2",
		"@vimeo/player": "^2.25.0",
		"svelte-gestures": "^4.0.0"
	},
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": ">=20"
	}
}
